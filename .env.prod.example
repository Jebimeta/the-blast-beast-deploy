# Plantilla de producción. Copia a `.env.prod` y rellena los valores:
#
#   ./ops/generate-env.sh
#
# `.env.prod` está en .gitignore y debe tener permisos 600.
# No uses estos valores de ejemplo en un servidor real.

# --- Dominio y TLS ---
# Dominio apex, sin esquema ni www. Caddy emite el certificado automáticamente.
SITE_DOMAIN=theblastbeast.com
# Correo para Let's Encrypt (avisos de caducidad y problemas con el certificado).
ACME_EMAIL=admin@theblastbeast.com
SITE_BASE_URL=https://theblastbeast.com
ALLOWED_HOSTS=theblastbeast.com,www.theblastbeast.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Base de datos ---
DB_NAME=blastbeast
DB_USER=blastbeast
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# --- Autenticación ---
# Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTE_SECRETO
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=

# --- Medios ---
STORAGE_PUBLIC_BASE_URL=https://theblastbeast.com/media

# --- Bootstrap del primer administrador ---
# Solo se usa si la tabla de usuarios está vacía. Guárdala en tu gestor de
# contraseñas: el bootstrap no se repite y no hay flujo de cambio desde el panel.
ADMIN_EMAIL=redaccion@theblastbeast.com
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE
ADMIN_DISPLAY_NAME=Redacción Blast Beast

# --- Agenda de conciertos (Ticketmaster) ---
# Clave gratuita de https://developer.ticketmaster.com/. Sin clave la agenda
# queda vacía y la sincronización se omite sin afectar al resto del portal.
TICKETMASTER_ENABLED=false
TICKETMASTER_API_KEY=

# --- Difusión en redes (IA opcional) ---
# Proveedor compatible con OpenAI. Sin AI_API_KEY se usa una plantilla local.
# Con clave, el texto del artículo se envía al proveedor solo al pulsar
# «Generar textos» en el editor; no se envían datos de lectores.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=20s

# --- Imágenes a desplegar ---
# `latest` o el SHA del commit publicado en cada repo de GHCR. En producción
# usa SHA inmutables: API y web son repos distintos y sus SHA no coinciden.
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest

# --- Backups ---
BACKUP_DIR=/var/backups/the-blast-beast
BACKUP_RETENTION_DAYS=14
# Clave pública age para cifrar los backups. La privada NO va en el servidor.
# Genera el par en tu máquina: age-keygen -o blast-beast-backup.key
BACKUP_AGE_RECIPIENT=

# --- Monitorización ---
# Webhook compatible con Slack (Discord: añade /slack al final de su URL).
ALERT_WEBHOOK_URL=
