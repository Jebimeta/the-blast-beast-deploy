# Copia este archivo a .env para cambiar los valores por defecto de Docker Compose.
# Los valores de abajo son los mismos que usa el compose si no existe .env.

DB_NAME=blastbeast
DB_USER=blastbeast
DB_PASSWORD=blastbeast

# Origen público del sitio (CORS de la API).
SITE_BASE_URL=http://localhost:8088

# Dominio que sirve Caddy. En producción: theblastbeast.com (TLS automático).
SITE_DOMAIN=http://localhost
CADDY_PORT=8088

# Hosts que acepta el motor SSR de Angular.
ALLOWED_HOSTS=localhost,127.0.0.1

# M2: mínimo 32 bytes. Genera una con: openssl rand -base64 48
JWT_SECRET=
