# Copia este archivo a .env para cambiar los valores por defecto de Docker Compose.
# Los valores de abajo son los mismos que usa el compose si no existe .env.
#
# Este archivo es para desarrollo local. Para producción usa `.env.prod.example`
# y `ops/generate-env.sh` (ver docs/06-produccion.md).

DB_NAME=blastbeast
DB_USER=blastbeast
DB_PASSWORD=blastbeast

# Origen público del sitio (CORS de la API y canonical/OG del SSR).
SITE_BASE_URL=http://localhost:8088

# Perfil de Spring. `dev` carga el contenido de ejemplo; vacío no carga seed.
SPRING_PROFILES_ACTIVE=dev

# Dominio que sirve Caddy. En producción: theblastbeast.com (TLS automático).
SITE_DOMAIN=http://localhost
CADDY_PORT=8088

# Hosts que acepta el motor SSR de Angular.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Autenticación (M2) ---
# Mínimo 32 bytes. Genera una con: openssl rand -base64 48
# Si lo dejas vacío, Compose usa una clave solo para desarrollo.
JWT_SECRET=
# En producción con HTTPS, ponlo a true para que la cookie de refresco sea Secure.
AUTH_COOKIE_SECURE=false
# Dominio de la cookie de refresco (vacío = mismo host).
AUTH_COOKIE_DOMAIN=

# --- Medios (M2) ---
# URL pública con la que la API construye las URLs de las imágenes.
# En producción: https://theblastbeast.com/media
STORAGE_PUBLIC_BASE_URL=http://localhost:8088/media

# --- Bootstrap del primer usuario (M2) ---
# Si la tabla de usuarios está vacía, la API crea este ADMIN al arrancar.
# Con el perfil `dev` ya existe redaccion@theblastbeast.com / Redaccion2026!.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Redacción Blast Beast
